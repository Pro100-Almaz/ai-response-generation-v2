# Application Configuration
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
DEBUG=true


# PostgreSQL Configuration
POSTGRES_USER=fastapi_user
POSTGRES_PASSWORD=fastapi_strong_pwd
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_db






# External APIs
MUSEUM_API_BASE=https://api.example.com
CATALOG_API_BASE=https://catalog.example.com
HTTP_TIMEOUT=10.0




# Message Broker (RabbitMQ)
BROKER_URL=amqp://guest:guest@rabbitmq:5672/
BROKER_NEW_ARTIFACT_QUEUE=new_artifacts

# Retry Configuration
PUBLISH_RETRIES=3
PUBLISH_RETRY_BACKOFF=0.5





# Redis Configuration
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_HOST=redis
REDIS_DB=0
REDIS_CACHE_TTL=3600
REDIS_CACHE_PREFIX=ai_response_generation_v2:

# OpenAI Configuration
OPENAI_API_KEY=changeme
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=

# Monolith Authorization
MONOLITH_BASE_URL=http://monolith.example.com
MONOLITH_AUTH_AUDIENCE=api://ai-response-generation
MONOLITH_AUTH_TIMEOUT=3.0
MONOLITH_PUBLIC_KEY_PATH=/app/secrets/monolith_public_key.pem









# Database URLs (computed)
DATABASE_URL=postgresql+asyncpg://fastapi_user:fastapi_strong_pwd@postgres:5432/fastapi_db







REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}








# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
